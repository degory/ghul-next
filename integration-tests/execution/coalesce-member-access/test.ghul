namespace Test is
    use IO.Std;

    // `?.` coalescing member access: the receiver is tested for
    // presence and the member loaded only when present, otherwise
    // the result is the optional null. Exercises COALESCE_LOAD on
    // the binary emission path.
    class BOX is
        value: int;
        init(value: int) is self.value = value; si
    si

    lookup(id: int) -> BOX? => if id > 0 then BOX(id) else null fi;

    class Main is
        entry() static is
            let present = lookup(42);
            let v = present?.value;
            if v? then
                Std.write_line("present: {v}");
            fi;

            let absent = lookup(-1);
            let missing = absent?.value;
            if !missing? then
                Std.write_line("absent");
            fi;
        si
    si
si
