namespace IR is
    use System.NotImplementedException;
    use IO.File;

    use Values.Call;

    class AssemblyOutput(want_comments: bool) abstract is
        write(value: object) is
            throw NotImplementedException("assembly output must implement write_line");            
        si
        
        write_line(value: object) is
            write(value);
            write("\n");
        si
        
        write_line(indent: int, value: object) is
            if want_comments then
                write_indent(indent);
                write_line(value);
            else
                write_line(value);

                
            fi
        si

        write_line(indent: int, value: object, comment: object) is
            if want_comments then               
                write_indent(indent);
                write_line("{value}        // {comment}");
            else
                write_line(value);
            fi
        si

        write_comment_line(indent: int, comment: object) is
            if want_comments then
                write_indent(indent);
                write_line("// {comment}");
            fi
        si

        write_indent(indent: int) is
            for i in 0..indent do
                write("  ");
            od            
        si

        close() is
            
        si
    si

    class INVALID_ASSEMBLER_OUTPUT: AssemblyOutput is
        init() is
            super.init(false);
        si

        write(value: object) is
            assert false else "code generated outside of block";
        si
    si

    class FILE_ASSEMBLER_OUTPUT(
        path: string,
        writer: IO.TextWriter,
        want_comments: bool
    ): AssemblyOutput is
        super(want_comments);

        write(value: object) is
            writer.write(value);
        si

        close() is
            writer.close();
        si
    si

    class NULL_ASSEMBLER_OUTPUT: AssemblyOutput is
        init() is
            super.init(false);
        si

        write(value: object) is
            // do nothing
        si
    si

    class BUFFER_ASSEMBLER_OUTPUT: AssemblyOutput is
        buffer: System.Text.StringBuilder;

        init(want_comments: bool) is
            super.init(want_comments);

            buffer = System.Text.StringBuilder();
        si

        write(value: object) is
            buffer.append(value);
        si
    si
    
    class CONTEXT is
        _logger: Logging.Logger;
        _indent: int;

        _seen: Collections.SET[string];
        _outputs: Collections.STACK[AssemblyOutput];

        entry_point_name: string public;
        seen_entrypoint: bool public;

        throw_on_fixme: bool public;

        // Binary emission state, carried here so that a value's `gen`
        // can reach the method body it is being emitted into without
        // every caller threading it through. The assembly emitter is
        // set by the driver when a build targets an assembly; the body
        // emitter tracks the method the IL visitor currently has open,
        // and is null outside one.
        srm_assembly_emitter: Emitter.SRM_ASSEMBLY_EMITTER? public;
        current_srm_body_emitter: Emitter.SRM_METHOD_BODY_EMITTER? public;

        // Reads `--debug` off the shared build-flags singleton so
        // non-debug builds pay nothing for the `mark_location` check.
        want_debug_info: bool =>
            IoC.CONTAINER.instance.build_flags.want_debug;

        // Last emitted `.line` source position (file + start_line +
        // start_column). mark_location only writes a fresh directive
        // when the position changes, keeping the IL stream sparse
        // while still letting two distinct constructs that share a
        // source line (e.g. both arms of `if c then a else b fi`
        // written on one line) each get their own sequence point.
        _last_line_file: string?;
        _last_line_line: int;
        _last_line_column: int;

        init(
            logger: Logging.Logger,
            entry_point_name: string
        ) is
            _logger = logger;
            self.entry_point_name = entry_point_name;

            _seen = Collections.SET[string]();
            _outputs = Collections.STACK[AssemblyOutput]();

            _outputs.push(NULL_ASSEMBLER_OUTPUT());
        si

        // Note a source-language position at the current emission
        // point. If debug info is enabled and the (file, line,
        // column) triple differs from the most recently emitted
        // one, write a `.line` directive ahead of the next
        // instruction. Internal / sentinel locations are ignored.
        mark_location(location: Source.LOCATION?) is
            if !want_debug_info \/ !location? \/ location.is_internal then
                return;
            fi

            // Emit an absolute path so the resulting Portable PDB's
            // Document records match what an IDE will send in a
            // breakpoint request (which is the file's absolute path).
            // A bare basename here would still produce a syntactically
            // valid PDB but every breakpoint would silently fail to
            // bind.
            let file = IO.Path.get_full_path(location.file_name);
            let line = location.start_line;
            let column = location.start_column;

            if
                _last_line_file? /\ _last_line_file =~ file /\
                _last_line_line == line /\ _last_line_column == column
            then
                return;
            fi

            _last_line_file = file;
            _last_line_line = line;
            _last_line_column = column;

            let end_line = location.end_line;
            let end_col_exclusive = location.end_column + 1;

            write_line(".line {line},{end_line} : {column},{end_col_exclusive} '{file}'");
        si

        // Per-method reset called when entering a new method body
        // so the first statement always gets a `.line` directive
        // even if it sits on the same source position the previous
        // method ended on.
        reset_line_tracking() is
            _last_line_file = null;
            _last_line_line = 0;
            _last_line_column = 0;
        si

        current_output: AssemblyOutput => _outputs.peek();

        fixme(value: object) is
            if throw_on_fixme then
                throw System.NotImplementedException("FIXME: {value}");
            else
                write_line("// FIXME: {value}");
            fi            
        si

        write(value: string) is
            current_output.write(value);
        si
            
        // Text IL reaching this while a method body is being encoded
        // means some value has no binary branch and has fallen through
        // to its text one. There is no file open to receive it, so
        // without this it would be dropped: the encoded body would
        // simply be missing those instructions, and the first sign of
        // it would be a JIT-time InvalidProgramException naming the
        // method but nothing inside it. Failing here names the
        // instruction that was not emitted.
        _reject_text_in_binary_body(value: object) is
            if !current_srm_body_emitter? then
                return;
            fi

            let text = "{value}";

            // `.maxstack` is a body-header field that
            // MethodBodyStreamEncoder takes as an argument rather than
            // an instruction, and `.line` is a debug sequence point the
            // binary path does not emit yet. Neither is a dropped
            // instruction.
            if text.starts_with(".maxstack") \/ text.starts_with(".line") \/ text.starts_with("//") then
                return;
            fi

            throw System.NotImplementedException(
                "the binary back end has no emission for '{value}' yet");
        si

        write_line(value: object) is
            _reject_text_in_binary_body(value);

            current_output.write_line(_indent, value);
        si

        write_line(value: object, comment: object) is            
            _reject_text_in_binary_body(value);

            current_output.write_line(_indent, value, comment);
        si

        write_comment_line(comment: object) is
            current_output.write_comment_line(_indent, comment);
        si
        
        indent() is
            _indent = _indent + 1;
        si

        outdent() is
            _indent = _indent - 1;
        si

        enter_invalid() is
            _outputs.push(INVALID_ASSEMBLER_OUTPUT());
        si

        leave_invalid() is
            assert
                _outputs.count > 0 /\
                isa INVALID_ASSEMBLER_OUTPUT(current_output)
            else
                "IL output context stack corrupt";

            _outputs.pop();
        si

        enter_file(path: string, want_comments: bool) is
            let writer: IO.TextWriter mut;

            if _seen.contains(path) then
                writer = File.append_text(path);
            else
                writer = File.create_text(path);
                _seen.add(path);
            fi
            
            _outputs.push(FILE_ASSEMBLER_OUTPUT(path, writer, want_comments));
        si

        leave_file(path: string) is
            assert
                _outputs.count > 0 /\
                isa FILE_ASSEMBLER_OUTPUT(current_output) /\
                cast FILE_ASSEMBLER_OUTPUT(current_output).path =~ path
            else
                "IL output context stack corrupt";
            
            current_output.close();
            _outputs.pop();
        si
        
        enter_buffer(want_comments: bool) is
            _outputs.push(BUFFER_ASSEMBLER_OUTPUT(want_comments));
        si

        leave_buffer() -> string is
            assert
                _outputs.count > 0 /\
                isa BUFFER_ASSEMBLER_OUTPUT(current_output)
            else
                "IL output context stack corrupt";

            let result = cast BUFFER_ASSEMBLER_OUTPUT(current_output).buffer;

            _outputs.pop();

            return result.to_string();
        si

        // Resolves a call target to a member reference. Handles the two
        // owner shapes a call can have: a ghūl global function, hosted on
        // its namespace's $globals carrier, and a static method, hosted
        // directly on its declaring type.
        //
        // Only void-returning signatures taking zero or one string
        // argument are encoded; anything else needs the signature blob
        // built from the function's actual argument and return types.
        // The CLR parameter index of a named argument.
        //
        // The text back end addresses arguments by name and lets ilasm
        // resolve them against the method's declared parameters;
        // metadata has only positions. An instance method's slot 0 is
        // the receiver, so a declared argument sits one further along.
        resolve_argument_index(symbol: Semantic.Symbols.Symbol) -> int is
            let function = cast Semantic.Symbols.Function?(symbol.owner);

            assert function? else
                "argument '{symbol.name}' is not owned by a function";

            let names = function.argument_names;

            for i in 0..names.count do
                if names[i] =~ symbol.name then
                    return if function.is_instance then i + 1 else i fi;
                fi
            od

            assert false else
                "argument '{symbol.name}' is not declared by {function.name}";

            return 0;
        si

        // The metadata token naming a type, for instructions that take
        // one directly (box, castclass, isinst). A constructed generic
        // needs a TypeSpec rather than a bare reference, which is not
        // built yet, so those report rather than emitting a token that
        // names the open definition.
        // A unit variant is constructed by loading the one interned
        // instance the back end synthesises for it, rather than by
        // calling its constructor.
        resolve_unit_variant_instance(
            variant: Semantic.Scope
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            // A specialization holds the open definition rather than
            // being one, and only the definition has a row.
            let classy =
                if let generic: Semantic.Symbols.GENERIC = variant then
                    cast Semantic.Symbols.Classy?(generic.symbol)
                else
                    cast Semantic.Symbols.Classy?(variant)
                fi;

            assert classy? else "unit variant '{variant.name}' is not a type";

            if classy.is_generic then
                throw System.NotImplementedException(
                    "the binary back end cannot yet reach the interned instance of "
                    "the generic unit variant '{classy.qualified_name}'");
            fi

            let instance = emitter.handles.unit_variant_instance(classy);

            assert instance? else "unit variant '{variant.name}' has no interned instance";

            return cast System.Reflection.Metadata.EntityHandle(instance);
        si

        resolve_type_token(type: Semantic.Types.Type) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            // A constructed generic has no row of its own, and neither
            // does a type parameter or a primitive: all three are
            // structural types, named by a specification carrying their
            // encoded shape. A primitive especially cannot be named by
            // reference — its il_name_override is the assembler keyword
            // (`int8`, `int32`), which is not what the type is called.
            if type.arguments.count > 0 \/
               isa Semantic.Symbols.GenericArgument(type.symbol) \/
               type.symbol.il_is_primitive_type
            then
                return cast System.Reflection.Metadata.EntityHandle(
                    emitter.add_type_specification(type));
            fi

            // Same unwrapping as the signature encoder: a constructed
            // generic's symbol holds the open definition rather than
            // being one, and only the definition has a row.
            let symbol =
                if let generic: Semantic.Symbols.GENERIC = type.symbol then
                    generic.symbol
                else
                    cast Semantic.Symbols.Classy?(type.symbol)
                fi;

            assert symbol? else "cannot name the type '{type}' in an instruction";

            if let definition = emitter.handles.type_definition(symbol) then
                return cast System.Reflection.Metadata.EntityHandle(definition);
            fi

            return cast System.Reflection.Metadata.EntityHandle(
                Emitter.SRM_SIGNATURE_ENCODER(emitter).type_reference_for(symbol));
        si

        // Invoking a function value calls Invoke on the delegate type.
        resolve_delegate_invoke(
            func_type: Semantic.Types.Type,
            argument_count: int,
            is_action: bool
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(func_type),
                    "Invoke",
                    "Invoke {func_type}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .delegate_invoke_signature(argument_count, is_action)));
        si

        // A tuple and a wrapped optional are both a constructed generic
        // built from one value per type parameter, so both reach their
        // constructor the same way: through the owning TypeSpec, with
        // the parameters written as indexes.
        resolve_generic_constructor(
            type: Semantic.Types.Type,
            argument_count: int
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    resolve_type_token(type),
                    ".ctor",
                    ".ctor {type}/{argument_count}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter)
                        .generic_constructor_signature(argument_count)));
        si

        // A range struct is constructed from its two integer bounds.
        resolve_range_constructor(
            range_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup;

            let arguments = Collections.LIST[Semantic.Types.Type]();

            arguments.add(lookup.get_int_type());
            arguments.add(lookup.get_int_type());

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    resolve_type_token(range_type),
                    "range .ctor {range_type}",
                    arguments));
        si

        // A delegate is constructed from a receiver and a function
        // pointer, so its constructor always takes (object, native int).
        // The delegate type is normally a constructed generic, which
        // has no reference row of its own: its TypeSpec is the owner.
        resolve_delegate_constructor(
            delegate_type: Semantic.Types.Type
        ) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;
            let lookup = IoC.CONTAINER.instance.innate_symbol_lookup;

            let arguments = Collections.LIST[Semantic.Types.Type]();

            arguments.add(lookup.get_object_type());
            arguments.add(lookup.get_word_type());

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_constructor_reference(
                    resolve_type_token(delegate_type),
                    "delegate .ctor {delegate_type}",
                    arguments));
        si

        // The metadata token naming a field, for a load or store.
        // Same rule as resolve_call_target: a field this assembly
        // defines is named by its own FieldDef row, whose number the
        // numbering pass has already fixed.
        resolve_field_target(`field: Semantic.Symbols.Field) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            if let definition = emitter.handles.field_definition(`field) then
                return cast System.Reflection.Metadata.EntityHandle(definition);
            fi

            let root = cast Semantic.Symbols.Field?(`field.root_specialized_from) ?? `field;

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_named_member_reference(
                    cast System.Reflection.Metadata.EntityHandle(_imported_owner_reference(root)),
                    root.name,
                    "field {root.owner}::{root.name}",
                    Emitter.SRM_SIGNATURE_ENCODER(emitter).field_signature(root)));
        si

        // The reference row for the type an imported member hangs off.
        // A global function or variable hangs off its namespace's
        // globals carrier, which is a naming convention rather than a
        // declared type; everything else hangs off its owning type.
        _imported_owner_reference(
            member: Semantic.Symbols.Symbol
        ) -> System.Reflection.Metadata.TypeReferenceHandle is
            let emitter = srm_assembly_emitter!;

            let globals_assembly_name =
                if let global_function: Semantic.Symbols.GLOBAL_FUNCTION = member then
                    global_function.il_assembly_name ?? "";
                elif let global_variable: Semantic.Symbols.GLOBAL_VARIABLE = member then
                    global_variable.il_assembly_name ?? "";
                else
                    null;
                fi;

            // Anything a namespace owns is emitted onto that namespace's
            // globals carrier, whatever kind of member it is. The owner
            // is sometimes the namespace symbol and sometimes the scope
            // standing for it, and only the latter answers
            // `containing_namespace`.
            let owner_namespace =
                if let declared: Semantic.Symbols.NAMESPACE = member.owner then
                    declared;
                elif let scope: Semantic.NAMESPACE_SCOPE = member.owner then
                    scope.containing_namespace;
                else
                    null;
                fi;

            if owner_namespace? then
                return emitter.add_type_reference(
                    owner_namespace,
                    _referenced_assembly(globals_assembly_name ?? "", owner_namespace),
                    owner_namespace.qualified_name.substring(1),
                    Semantic.DotNet.GLOBALS_CARRIER.name);
            fi

            // A constructed generic owner holds the open definition
            // rather than being one, and the reference is to the open
            // type: the instantiation lives in the specification built
            // over it.
            let owner_classy =
                if let generic: Semantic.Symbols.GENERIC = member.owner then
                    cast Semantic.Symbols.Classy?(generic.symbol)
                else
                    cast Semantic.Symbols.Classy?(member.owner)
                fi;

            assert owner_classy? else "cannot reference a member owned by {member.owner}";

            // il_name_override on an imported type is the CLR-side
            // dotted full name (see symbol_factory.ghul's get_il_name),
            // unlike qualified_name which is the ghūl-mapped spelling
            // (e.g. "IO.Std" for System.Console). It arrives quoted
            // for ilasm, which metadata must not carry.
            let clr_type_name =
                Emitter.SRM_SIGNATURE_ENCODER.unquote(
                    owner_classy.il_name_override ?? owner_classy.qualified_name);

            let dot = clr_type_name.last_index_of('.');

            return emitter.add_type_reference(
                owner_classy,
                _referenced_assembly(owner_classy.il_assembly_name ?? "", owner_classy),
                if dot >= 0 then clr_type_name.substring(0, dot) else "" fi,
                if dot >= 0 then clr_type_name.substring(dot + 1) else clr_type_name fi);
        si

        // A type reference names the assembly it points into, which has
        // to have a row of its own before anything can name it.
        //
        // An empty name is not a usable reference: it produces a row the
        // runtime resolves to the assembly being built, so every type
        // named through it appears to be one this assembly defines and
        // fails to load. Refuse it rather than emit that.
        _referenced_assembly(assembly_name: string, owner: Semantic.Symbols.Symbol) -> string is
            assert assembly_name.length > 0 else
                "'{owner.qualified_name}' names no assembly to reference it through";

            srm_assembly_emitter!.add_assembly_reference(assembly_name, "8:0:0:0");

            return assembly_name;
        si

        resolve_call_target(function: Semantic.Symbols.Function) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            // A target this assembly defines is called through its own
            // MethodDef row. The row does not exist yet — the numbering
            // pass fixed which row it will be, and the token embedded
            // here resolves once the structure walk writes it.
            if let definition = emitter.handles.method_definition(function) then
                return cast System.Reflection.Metadata.EntityHandle(definition);
            fi

            let owner_ref = _imported_owner_reference(function);

            // An instantiation of a generic method is named by a
            // MethodSpec over the open method, not by a reference of its
            // own: the reference carries the method's own type
            // parameters as indexes, and the arguments live in the spec.
            let root = cast Semantic.Symbols.Function?(function.root_specialized_from) ?? function;

            let signature = Emitter.SRM_SIGNATURE_ENCODER(emitter).method_signature(root);

            let reference =
                emitter.add_member_reference(
                    root,
                    owner_ref,
                    Emitter.SRM_FLAGS.method_name(root),
                    signature);

            if function.generic_arguments.count == 0 then
                return cast System.Reflection.Metadata.EntityHandle(reference);
            fi

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_method_specification(
                    cast System.Reflection.Metadata.EntityHandle(reference),
                    "{function}",
                    function.generic_arguments));
        si
    si
si
