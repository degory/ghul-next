namespace IR is
    use System.NotImplementedException;
    use IO.File;

    use Values.Call;

    class AssemblyOutput(want_comments: bool) abstract is
        write(value: object) is
            throw NotImplementedException("assembly output must implement write_line");            
        si
        
        write_line(value: object) is
            write(value);
            write("\n");
        si
        
        write_line(indent: int, value: object) is
            if want_comments then
                write_indent(indent);
                write_line(value);
            else
                write_line(value);
            fi
        si

        write_line(indent: int, value: object, comment: object) is
            if want_comments then
                write_indent(indent);
                write_line("{value}        // {comment}");
            else
                write_line(value);
            fi
        si

        write_comment_line(indent: int, comment: object) is
            if want_comments then
                write_indent(indent);
                write_line("// {comment}");
            fi
        si

        write_indent(indent: int) is
            for i in 0..indent do
                write("  ");
            od            
        si

        close() is
            
        si
    si

    class INVALID_ASSEMBLER_OUTPUT: AssemblyOutput is
        init() is
            super.init(false);
        si

        write(value: object) is
            assert false else "code generated outside of block";
        si
    si

    class FILE_ASSEMBLER_OUTPUT(
        path: string,
        writer: IO.TextWriter,
        want_comments: bool
    ): AssemblyOutput is
        super(want_comments);

        write(value: object) is
            writer.write(value);
        si

        close() is
            writer.close();
        si
    si

    class NULL_ASSEMBLER_OUTPUT: AssemblyOutput is
        init() is
            super.init(false);
        si

        write(value: object) is
            // do nothing
        si
    si

    class BUFFER_ASSEMBLER_OUTPUT: AssemblyOutput is
        buffer: System.Text.StringBuilder;

        init(want_comments: bool) is
            super.init(want_comments);

            buffer = System.Text.StringBuilder();
        si

        write(value: object) is
            buffer.append(value);
        si
    si
    
    class CONTEXT is
        _logger: Logging.Logger;
        _indent: int;

        _seen: Collections.SET[string];
        _outputs: Collections.STACK[AssemblyOutput];

        entry_point_name: string public;
        seen_entrypoint: bool public;

        throw_on_fixme: bool public;

        // Binary emission state, carried here so that a value's `gen`
        // can reach the method body it is being emitted into without
        // every caller threading it through. The assembly emitter is
        // set by the driver when a build targets an assembly; the type
        // and body emitters track what the IL visitor currently has
        // open, and are null outside one.
        srm_assembly_emitter: Emitter.SRM_ASSEMBLY_EMITTER? public;
        current_srm_type_emitter: Emitter.SRM_TYPE_EMITTER? public;
        current_srm_body_emitter: Emitter.SRM_METHOD_BODY_EMITTER? public;

        // Reads `--debug` off the shared build-flags singleton so
        // non-debug builds pay nothing for the `mark_location` check.
        want_debug_info: bool =>
            IoC.CONTAINER.instance.build_flags.want_debug;

        // Last emitted `.line` source position (file + start_line +
        // start_column). mark_location only writes a fresh directive
        // when the position changes, keeping the IL stream sparse
        // while still letting two distinct constructs that share a
        // source line (e.g. both arms of `if c then a else b fi`
        // written on one line) each get their own sequence point.
        _last_line_file: string?;
        _last_line_line: int;
        _last_line_column: int;

        init(
            logger: Logging.Logger,
            entry_point_name: string
        ) is
            _logger = logger;
            self.entry_point_name = entry_point_name;

            _seen = Collections.SET[string]();
            _outputs = Collections.STACK[AssemblyOutput]();

            _outputs.push(NULL_ASSEMBLER_OUTPUT());
        si

        // Note a source-language position at the current emission
        // point. If debug info is enabled and the (file, line,
        // column) triple differs from the most recently emitted
        // one, write a `.line` directive ahead of the next
        // instruction. Internal / sentinel locations are ignored.
        mark_location(location: Source.LOCATION?) is
            if !want_debug_info \/ !location? \/ location.is_internal then
                return;
            fi

            // Emit an absolute path so the resulting Portable PDB's
            // Document records match what an IDE will send in a
            // breakpoint request (which is the file's absolute path).
            // A bare basename here would still produce a syntactically
            // valid PDB but every breakpoint would silently fail to
            // bind.
            let file = IO.Path.get_full_path(location.file_name);
            let line = location.start_line;
            let column = location.start_column;

            if
                _last_line_file? /\ _last_line_file =~ file /\
                _last_line_line == line /\ _last_line_column == column
            then
                return;
            fi

            _last_line_file = file;
            _last_line_line = line;
            _last_line_column = column;

            let end_line = location.end_line;
            let end_col_exclusive = location.end_column + 1;

            write_line(".line {line},{end_line} : {column},{end_col_exclusive} '{file}'");
        si

        // Per-method reset called when entering a new method body
        // so the first statement always gets a `.line` directive
        // even if it sits on the same source position the previous
        // method ended on.
        reset_line_tracking() is
            _last_line_file = null;
            _last_line_line = 0;
            _last_line_column = 0;
        si

        current_output: AssemblyOutput => _outputs.peek();

        fixme(value: object) is
            if throw_on_fixme then
                throw System.NotImplementedException("FIXME: {value}");
            else
                write_line("// FIXME: {value}");
            fi            
        si

        write(value: string) is
            current_output.write(value);
        si
            
        write_line(value: object) is
            current_output.write_line(_indent, value);
        si

        write_line(value: object, comment: object) is            
            current_output.write_line(_indent, value, comment);
        si

        write_comment_line(comment: object) is
            current_output.write_comment_line(_indent, comment);
        si
        
        indent() is
            _indent = _indent + 1;
        si

        outdent() is
            _indent = _indent - 1;
        si

        enter_invalid() is
            _outputs.push(INVALID_ASSEMBLER_OUTPUT());
        si

        leave_invalid() is
            assert
                _outputs.count > 0 /\
                isa INVALID_ASSEMBLER_OUTPUT(current_output)
            else
                "IL output context stack corrupt";

            _outputs.pop();
        si

        enter_file(path: string, want_comments: bool) is
            let writer: IO.TextWriter mut;

            if _seen.contains(path) then
                writer = File.append_text(path);
            else
                writer = File.create_text(path);
                _seen.add(path);
            fi
            
            _outputs.push(FILE_ASSEMBLER_OUTPUT(path, writer, want_comments));
        si

        leave_file(path: string) is
            assert
                _outputs.count > 0 /\
                isa FILE_ASSEMBLER_OUTPUT(current_output) /\
                cast FILE_ASSEMBLER_OUTPUT(current_output).path =~ path
            else
                "IL output context stack corrupt";
            
            current_output.close();
            _outputs.pop();
        si
        
        enter_buffer(want_comments: bool) is
            _outputs.push(BUFFER_ASSEMBLER_OUTPUT(want_comments));
        si

        leave_buffer() -> string is
            assert
                _outputs.count > 0 /\
                isa BUFFER_ASSEMBLER_OUTPUT(current_output)
            else
                "IL output context stack corrupt";

            let result = cast BUFFER_ASSEMBLER_OUTPUT(current_output).buffer;

            _outputs.pop();

            return result.to_string();
        si

        // Resolves a call target to a member reference. Handles the two
        // owner shapes a call can have: a ghūl global function, hosted on
        // its namespace's $globals carrier, and a static method, hosted
        // directly on its declaring type.
        //
        // Only void-returning signatures taking zero or one string
        // argument are encoded; anything else needs the signature blob
        // built from the function's actual argument and return types.
        // The CLR parameter index of a named argument.
        //
        // The text back end addresses arguments by name and lets ilasm
        // resolve them against the method's declared parameters;
        // metadata has only positions. An instance method's slot 0 is
        // the receiver, so a declared argument sits one further along.
        resolve_argument_index(symbol: Semantic.Symbols.Symbol) -> int is
            let function = cast Semantic.Symbols.Function?(symbol.owner);

            assert function? else
                "argument '{symbol.name}' is not owned by a function";

            let names = function.argument_names;

            for i in 0..names.count do
                if names[i] =~ symbol.name then
                    return if function.is_instance then i + 1 else i fi;
                fi
            od

            assert false else
                "argument '{symbol.name}' is not declared by {function.name}";

            return 0;
        si

        // The metadata token naming a field, for a load or store.
        // Same rule as resolve_call_target: a field this assembly
        // defines is named by its own FieldDef row, whose number the
        // numbering pass has already fixed.
        resolve_field_target(`field: Semantic.Symbols.Field) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            if let definition = emitter.handles.field_definition(`field) then
                return cast System.Reflection.Metadata.EntityHandle(definition);
            fi

            throw System.NotImplementedException(
                "the binary back end cannot yet reference the imported field '{`field.name}'");
        si

        resolve_call_target(function: Semantic.Symbols.Function) -> System.Reflection.Metadata.EntityHandle is
            let emitter = srm_assembly_emitter!;

            // A target this assembly defines is called through its own
            // MethodDef row. The row does not exist yet — the numbering
            // pass fixed which row it will be, and the token embedded
            // here resolves once the structure walk writes it.
            if let definition = emitter.handles.method_definition(function) then
                return cast System.Reflection.Metadata.EntityHandle(definition);
            fi

            let owner_symbol: Semantic.Symbols.Symbol mut;
            let assembly_name: string mut;
            let owner_namespace_path: string mut;
            let owner_simple_name: string mut;

            if let global_function: Semantic.Symbols.GLOBAL_FUNCTION = function then
                let owner_namespace = cast Semantic.Symbols.NAMESPACE(global_function.owner);

                owner_symbol = owner_namespace;
                assembly_name = global_function.il_assembly_name ?? "";
                owner_namespace_path = owner_namespace.qualified_name.substring(1);
                owner_simple_name = Semantic.DotNet.GLOBALS_CARRIER.name;
            elif let owner_classy: Semantic.Symbols.Classy = function.owner then
                // il_name_override on an imported type is the CLR-side
                // dotted full name (see symbol_factory.ghul's get_il_name),
                // unlike qualified_name which is the ghūl-mapped spelling
                // (e.g. "IO.Std" for System.Console). It arrives quoted
                // for ilasm, which metadata must not carry.
                let clr_type_name =
                    Emitter.SRM_SIGNATURE_ENCODER.unquote(
                        owner_classy.il_name_override ?? owner_classy.qualified_name);

                let dot = clr_type_name.last_index_of('.');

                owner_symbol = owner_classy;

                assembly_name = owner_classy.il_assembly_name ?? "";
                owner_namespace_path = if dot >= 0 then clr_type_name.substring(0, dot) else "" fi;
                owner_simple_name = if dot >= 0 then clr_type_name.substring(dot + 1) else clr_type_name fi;
            else
                assert false else "cannot resolve a call target owned by {function.owner}";

                return _;
            fi

            let owner_ref =
                emitter.add_type_reference(owner_symbol, assembly_name, owner_namespace_path, owner_simple_name);

            let signature = Emitter.SRM_SIGNATURE_ENCODER(emitter).method_signature(function);

            return cast System.Reflection.Metadata.EntityHandle(
                emitter.add_member_reference(
                    function,
                    owner_ref,
                    Emitter.SRM_FLAGS.method_name(function),
                    signature));
        si
    si
si
