namespace IR.Values is
    use Semantic.Types.Type;

    // Declares one CLR local.
    //
    // The text back end writes a `.locals init` directive naming the
    // local and leaves the slot numbering to ilasm. Metadata has no
    // directive: a body header points at a StandAloneSig listing the
    // local types in slot order, and every load and store addresses a
    // slot by index. Both need the same declaration, so it is a value
    // in the block rather than raw text one back end can read and the
    // other cannot.
    //
    // Being in the block also gets the ordering right for free: a
    // declaration is emitted before the loads that follow it, so the
    // slot exists by the time one is encoded.
    class DECLARE_LOCAL: Value is
        name: string;
        type: Type;

        init(name: string, type: Type) is
            super.init();

            self.name = name;
            self.type = type;
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                body.declare_local(name, type);

                return;
            fi

            let buffer = System.Text.StringBuilder();

            buffer.append(".locals init (");
            type.gen_type(buffer);
            buffer.append(' ').append(name).append(')');

            context.write_line(buffer);
        si

        to_string() -> string => "declare-local:[{type}]({name})";
    si

    // Stores the top of the stack into a named local. The counterpart
    // of DECLARE_LOCAL, and raw text for the same reason.
    class STORE_TEMP: Value is
        name: string;
        type: Type;

        init(name: string, type: Type) is
            super.init();

            self.name = name;
            self.type = type;
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                body.stloc(name);

                return;
            fi

            context.write_line("stloc {name}");
        si

        to_string() -> string => "store-temp:[{type}]({name})";
    si
si
