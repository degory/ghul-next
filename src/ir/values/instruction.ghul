namespace IR.Values is
    use System.Reflection.Metadata.ILOpCode;

    // A single operand-less IL instruction, named by its ilasm
    // mnemonic.
    //
    // The innate operator generator picks arithmetic and comparison
    // instructions by mnemonic — `op_name` on the operation, `cgt` or
    // `clt` chosen from the comparison direction — and pushes the
    // string into the block. Rather than restructure that choice, the
    // mnemonic is carried to whichever back end consumes it: written
    // as text, or looked up here.
    //
    // The lookup is exhaustive by construction: an unrecognised
    // mnemonic throws rather than emitting nothing, so a gap names
    // itself instead of producing a body that fails verification.
    class INSTRUCTION: Value is
        mnemonic: string;

        init(mnemonic: string) is
            super.init();

            self.mnemonic = mnemonic;
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                body.op(op_code_for(mnemonic));

                return;
            fi

            context.write_line(mnemonic);
        si

        op_code_for(mnemonic: string) -> ILOpCode static is
            case mnemonic
            when "add" then return ILOpCode.ADD;
            when "add.ovf" then return ILOpCode.ADD_OVF;
            when "add.ovf.un" then return ILOpCode.ADD_OVF_UN;
            when "sub" then return ILOpCode.SUB;
            when "sub.ovf" then return ILOpCode.SUB_OVF;
            when "sub.ovf.un" then return ILOpCode.SUB_OVF_UN;
            when "mul" then return ILOpCode.MUL;
            when "mul.ovf" then return ILOpCode.MUL_OVF;
            when "mul.ovf.un" then return ILOpCode.MUL_OVF_UN;
            when "div" then return ILOpCode.DIV;
            when "div.un" then return ILOpCode.DIV_UN;
            when "rem" then return ILOpCode.REM;
            when "rem.un" then return ILOpCode.REM_UN;
            when "and" then return ILOpCode.AND;
            when "or" then return ILOpCode.OR;
            when "xor" then return ILOpCode.XOR;
            when "shl" then return ILOpCode.SHL;
            when "shr" then return ILOpCode.SHR;
            when "shr.un" then return ILOpCode.SHR_UN;
            when "neg" then return ILOpCode.NEG;
            when "not" then return ILOpCode.NOT;
            when "ceq" then return ILOpCode.CEQ;
            when "cgt" then return ILOpCode.CGT;
            when "cgt.un" then return ILOpCode.CGT_UN;
            when "clt" then return ILOpCode.CLT;
            when "clt.un" then return ILOpCode.CLT_UN;
            when "pop" then return ILOpCode.POP;
            when "dup" then return ILOpCode.DUP;
            when "ldnull" then return ILOpCode.LDNULL;
            when "throw" then return ILOpCode.THROW;
            when "ret" then return ILOpCode.RET;
            when "ldc.i4.m1" then return ILOpCode.LDC_I4_M1;
            when "ldc.i4.0" then return ILOpCode.LDC_I4_0;
            when "ldc.i4.1" then return ILOpCode.LDC_I4_1;
            when "conv.i1" then return ILOpCode.CONV_I1;
            when "conv.u1" then return ILOpCode.CONV_U1;
            when "conv.i2" then return ILOpCode.CONV_I2;
            when "conv.u2" then return ILOpCode.CONV_U2;
            when "conv.i4" then return ILOpCode.CONV_I4;
            when "conv.u4" then return ILOpCode.CONV_U4;
            when "conv.i8" then return ILOpCode.CONV_I8;
            when "conv.u8" then return ILOpCode.CONV_U8;
            when "conv.r4" then return ILOpCode.CONV_R4;
            when "conv.r8" then return ILOpCode.CONV_R8;
            when "conv.i" then return ILOpCode.CONV_I;
            when "conv.u" then return ILOpCode.CONV_U;
            else
                throw System.NotImplementedException(
                    "the binary back end has no opcode for the instruction '{mnemonic}' yet");
            esac
        si

        to_string() -> string => mnemonic;
    si
si
