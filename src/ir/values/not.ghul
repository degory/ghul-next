namespace IR.Values is
    use TypeTyped = Semantic.Types.Typed;
    use Semantic.Types.Type;

    class NOT: Value is
        value: Value;

        type: Type? => value.type;
        is_value_type: bool => value.is_value_type;

        init(value: Value) is
            super.init();

            self.value = value;
        si

        gen(context: IR.CONTEXT) is
            Value.gen(value, context);

            if let body = context.current_srm_body_emitter then
                body.ldc_i4(0);
                body.op(System.Reflection.Metadata.ILOpCode.CEQ);

                return;
            fi

            context.write_line("ldc.i4 0");
            context.write_line("ceq");
        si

            to_string() -> string =>
                "not:[{type}]({value})";
            si
si