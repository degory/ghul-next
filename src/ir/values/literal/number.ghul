namespace IR.Values.Literal is
    use TypeTyped = Semantic.Types.Typed;
    use Semantic.Types.Type;

    // A numeric constant, held as the value rather than as the way it
    // was written down. A source literal can be written in any radix
    // and with any suffix, so the spelling and the value are not the
    // same thing: `0xFF00FF00` is a `uint` in range, and reading that
    // spelling back as a number is not something either back end
    // should have to do.
    //
    // Integers are carried unsigned and reinterpreted at the width the
    // load asks for, which is what makes the `uint` case above work:
    // it does not fit `int32` as a magnitude, and the constant `ldc.i4`
    // takes is the 32-bit pattern, not the magnitude.
    class NUMBER: Value, TypeTyped is
        integer_value: ulong;
        real_value: double;
        type: Type;
        suffix: string;
        conv: string?;
        is_lightweight_pure: bool => true;

        is_real: bool => suffix =~ "r4" \/ suffix =~ "r8";

        _as_int32: int => cast int(cast uint(integer_value));
        _as_int64: long => cast long(integer_value);

        // What ilasm is given for the constant. Written from the value,
        // so it agrees with what the binary back end pushes.
        value: string =>
            if is_real then
                "{real_value}";
            elif suffix =~ "i8" then
                "{_as_int64}";
            else
                "{_as_int32}";
            fi;

        init(integer_value: ulong, real_value: double, type: Type, suffix: string, conv: string?) is
            super.init();

            self.integer_value = integer_value;
            self.real_value = real_value;
            self.type = type;
            self.suffix = suffix;
            self.conv = conv;
        si

        init(value: ulong, type: Type, suffix: string, conv: string?) is
            self.init(value, 0.0D, type, suffix, conv);
        si

        init(value: ulong, type: Type, suffix: string) is
            self.init(value, 0.0D, type, suffix, null);
        si

        init(value: long, type: Type, suffix: string) is
            self.init(cast ulong(value), 0.0D, type, suffix, null);
        si

        init(value: int, type: Type, suffix: string) is
            self.init(cast ulong(cast uint(value)), 0.0D, type, suffix, null);
        si

        init(value: double, type: Type, suffix: string) is
            self.init(0UL, value, type, suffix, null);
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                _gen_srm(body);

                if conv? then
                    _gen_srm_conversion(body);
                fi

                return;
            fi

            context.write_line("ldc.{suffix} {value}");

            if conv? then
                context.write_line(conv!);
            fi
        si

        // `suffix` is the operand-size selector (`i4`, `i8`, `r4`,
        // `r8`), which decides the width the value is loaded at.
        _gen_srm(body: IR.Emitter.SRM_METHOD_BODY_EMITTER) is
            if suffix =~ "i4" then
                body.ldc_i4(_as_int32);
            elif suffix =~ "i8" then
                body.ldc_i8(_as_int64);
            elif suffix =~ "r4" then
                body.ldc_r4(cast single(real_value));
            elif suffix =~ "r8" then
                body.ldc_r8(real_value);
            else
                throw System.NotImplementedException(
                    "the binary back end cannot load a numeric literal of size '{suffix}' yet");
            fi
        si

        // `conv` is a bare ilasm conversion mnemonic appended after the
        // load, narrowing the pushed constant to the literal's declared
        // type.
        _gen_srm_conversion(body: IR.Emitter.SRM_METHOD_BODY_EMITTER) is
            if conv! =~ "conv.i1" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_I1);
            elif conv! =~ "conv.u1" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_U1);
            elif conv! =~ "conv.i2" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_I2);
            elif conv! =~ "conv.u2" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_U2);
            elif conv! =~ "conv.i4" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_I4);
            elif conv! =~ "conv.u4" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_U4);
            elif conv! =~ "conv.i8" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_I8);
            elif conv! =~ "conv.u8" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_U8);
            elif conv! =~ "conv.i" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_I);
            elif conv! =~ "conv.u" then
                body.op(System.Reflection.Metadata.ILOpCode.CONV_U);
            else
                throw System.NotImplementedException(
                    "the binary back end cannot emit the conversion '{conv!}' yet");
            fi
        si

        to_string() -> string =>
            "literal:[{type}]({value})";
    si
si