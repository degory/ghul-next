namespace IR.Values is
    use Semantic.Types.Type;

    class ENTER_FILE: Value is
        path: string;

        init(
            path: string
        ) is
            super.init();

            self.path = path;
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                body.begin_capture();

                return;
            fi

            context.enter_file(path, false);
        si

        to_string() -> string =>
            "enter-file:({path})";        
    si

    class LEAVE_FILE: Value is
        path: string;

        init(
            path: string
        ) is
            super.init();

            self.path = path;
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                context.write_captured(path, body.end_capture());

                return;
            fi

            context.leave_file(path);
        si

        to_string() -> string =>
            "exit-file";    
    si
si
