namespace IR.Values is
    use Semantic.Types.Type;

    class ENTER_FILE: Value is
        path: string;

        init(
            path: string
        ) is
            super.init();

            self.path = path;
        si

        gen(context: IR.CONTEXT) is
            // The binary back end records the offset range the marked
            // statement emits, rather than writing the instructions to a
            // file. The range leaves the method as a custom attribute the
            // IL test runner reads; `enter_file` is the text path.
            if let body = context.current_srm_body_emitter then
                body.begin_il_output(path, context.next_il_output_sequence());

                return;
            fi

            context.enter_file(path, false);
        si

        to_string() -> string =>
            "enter-file:({path})";
    si

    class LEAVE_FILE: Value is
        path: string;

        init(
            path: string
        ) is
            super.init();

            self.path = path;
        si

        gen(context: IR.CONTEXT) is
            if let body = context.current_srm_body_emitter then
                body.end_il_output();

                return;
            fi

            context.leave_file(path);
        si

        to_string() -> string =>
            "exit-file";    
    si
si
