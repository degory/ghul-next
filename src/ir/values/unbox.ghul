namespace IR.Values is
    use Semantic.Types.Type;

    class UNBOX: Value is
        value: Value;
        type: Type? => value.type;
        is_value_type: bool => true;

        init(
            value: Value
        ) is
            super.init();

            self.value = value;
        si

        gen(context: IR.CONTEXT) is
            gen(value, context);

            if let body = context.current_srm_body_emitter then
                body.unbox_any(context.resolve_type_token(type!));

                return;
            fi

            context.write_line("unbox.any {type!.get_il_type()}");
        si

        to_string() -> string =>
            "unbox:[{type}]({value})";        
    si

si