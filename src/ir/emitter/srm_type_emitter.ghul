namespace IR.Emitter is
    use System.Reflection.Metadata.EntityHandle;
    use System.Reflection.Metadata.MethodDefinitionHandle;
    use System.Reflection.Metadata.Ecma335.MetadataTokens;
    use System.Reflection.Metadata.MethodAttributes;
    use System.Reflection.Metadata.MethodImplAttributes;
    use System.Reflection.Metadata.TypeAttributes;

    // One method, recorded during the walk and written as a metadata row
    // once every type is known. The body is already in the assembly's IL
    // stream by this point — only `body_offset` is carried here.
    class PENDING_METHOD(
        name: string,
        flags: MethodAttributes,
        signature_bytes: ubyte[],
        body_offset: int
    ) is
        is_entry_point: bool;

        mark_entry_point() is
            is_entry_point = true;
        si
    si

    // Accumulates the members of one type. A TypeDef row's member list
    // runs from its own pointer to the next row's, so a type's method
    // rows have to be one contiguous run: any row written for another
    // type in between is silently absorbed into whichever type's range
    // encloses it, producing an assembly that loads but reports the
    // wrong owner. Since ghūl emits closures, delegates and state
    // machines interleaved with the type that encloses them, rows cannot
    // be written during the walk — the walk records them here and
    // SRM_ASSEMBLY_EMITTER.flush_types writes them grouped afterwards.
    class SRM_TYPE_EMITTER(
        _assembly: SRM_ASSEMBLY_EMITTER,
        namespace_name: string,
        simple_name: string,
        base_type: EntityHandle,
        flags: TypeAttributes
    ) is
        pending_methods: Collections.LIST[PENDING_METHOD];

        init(..) is
            pending_methods = Collections.LIST[PENDING_METHOD]();
        si

        // Records a method definition. The body must already be flushed
        // to the assembly's method body stream (see
        // SRM_METHOD_BODY_EMITTER.flush) so `body_offset` is available.
        add_method(
            name: string,
            method_flags: MethodAttributes,
            signature_bytes: ubyte[],
            body_offset: int
        ) -> PENDING_METHOD is
            let pending = PENDING_METHOD(name, method_flags, signature_bytes, body_offset);

            pending_methods.add(pending);

            return pending;
        si

        // Hands the completed type to the assembly emitter. Nothing is
        // written to metadata yet.
        close() is
            _assembly.add_pending_type(self);
        si

        // Writes this type's method rows as one contiguous run, then the
        // TypeDef row pointing at the first of them.
        flush() is
            let first_method =
                MetadataTokens.method_definition_handle(_assembly.next_method_row);

            for pending in pending_methods do
                let handle = _assembly.add_method_definition(
                    pending.flags,
                    cast MethodImplAttributes(8),   // IL
                    _assembly.get_or_add_string(pending.name),
                    _assembly.get_or_add_blob(pending.signature_bytes),
                    pending.body_offset,
                    _);

                if pending.is_entry_point then
                    _assembly.set_entry_point(handle);
                fi
            od

            _assembly.add_type_definition(
                flags,
                _assembly.get_or_add_string(namespace_name),
                _assembly.get_or_add_string(simple_name),
                base_type,
                MetadataTokens.field_definition_handle(_assembly.next_field_row),
                first_method);
        si
    si
si
