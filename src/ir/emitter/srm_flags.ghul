namespace IR.Emitter is
    use System.Reflection.TypeAttributes;
    use System.Reflection.MethodAttributes;
    use System.Reflection.FieldAttributes;

    use Semantic.Symbols.Classy;
    use Semantic.Symbols.Function;
    use Semantic.Symbols.Field;

    // The metadata flag words for a definition, derived from the same
    // symbol predicates the text back end's `gen_access` / `gen_flags`
    // read. Kept together here, and out of the symbol classes, so the
    // two back ends stay independently replaceable.
    //
    // Deliberately mirrors the text path rather than improving on it.
    // Instance methods are emitted virtual without newslot, so a
    // same-named member in a subclass overrides by name and signature,
    // which is the dispatch behaviour ghūl source already relies on.
    class SRM_FLAGS is
        _PUBLIC_TYPE: int static => 1;
        _INTERFACE: int static => 32;
        _ABSTRACT_TYPE: int static => 128;
        _SEALED: int static => 256;
        _SEQUENTIAL_LAYOUT: int static => 8;
        _BEFORE_FIELD_INIT: int static => 1048576;

        type_attributes(type: Classy) -> TypeAttributes static is
            let flags mut = _PUBLIC_TYPE;

            if type.is_trait then
                return cast TypeAttributes(flags | _INTERFACE | _ABSTRACT_TYPE);
            fi

            if type.is_value_type then
                flags = flags | _SEALED | _SEQUENTIAL_LAYOUT;
            elif type.is_abstract then
                flags = flags | _ABSTRACT_TYPE;
            fi

            return cast TypeAttributes(flags | _BEFORE_FIELD_INIT);
        si

        globals_carrier_type_attributes() -> TypeAttributes static =>
            cast TypeAttributes(_PUBLIC_TYPE | _ABSTRACT_TYPE | _SEALED);

        _PRIVATE_METHOD: int static => 1;
        _ASSEMBLY_METHOD: int static => 3;
        _PUBLIC_METHOD: int static => 6;
        _STATIC: int static => 16;
        _VIRTUAL: int static => 64;
        _HIDE_BY_SIG: int static => 128;
        _ABSTRACT_METHOD: int static => 1024;
        _SPECIAL_NAME: int static => 2048;
        _RT_SPECIAL_NAME: int static => 4096;

        method_attributes(method: Function) -> MethodAttributes static is
            let flags mut =
                if method.is_public_readable then _PUBLIC_METHOD else _ASSEMBLY_METHOD fi;

            flags = flags | _HIDE_BY_SIG;

            // A constructor is never virtual: it is reached through the
            // type it constructs, so there is no slot for a subclass to
            // take over, and the runtime rejects the combination.
            if !method.is_emitted_with_receiver then
                flags = flags | _STATIC;
            elif method.is_virtual /\ !method.is_constructor then
                flags = flags | _VIRTUAL;
            fi

            // A constructor's IL name is reserved, which is what
            // rtspecialname asserts; the runtime rejects a `.ctor`
            // without it.
            if method.is_constructor then
                flags = flags | _SPECIAL_NAME | _RT_SPECIAL_NAME;
            elif method.is_internal then
                flags = flags | _SPECIAL_NAME;
            fi

            // A body-less declaration — an interface member, or an
            // abstract method — has no body for the row to point at.
            if method.is_abstract then
                flags = flags | _ABSTRACT_METHOD | _VIRTUAL;
            fi

            return cast MethodAttributes(flags);
        si

        // A unit variant's static constructor, which the back end
        // synthesises: private, static, and reserved-named like any
        // other `.cctor`.
        static_initializer_attributes() -> MethodAttributes static =>
            cast MethodAttributes(
                _PRIVATE_METHOD | _HIDE_BY_SIG | _STATIC | _SPECIAL_NAME | _RT_SPECIAL_NAME);

        // il_name_override arrives quoted for ilasm ('.ctor'); metadata
        // stores the bare name, and the quotes would become part of it.
        method_name(method: Function) -> string static =>
            method.il_bare_name.replace("'", "");

        _PRIVATE_FIELD: int static => 1;
        _ASSEMBLY_FIELD: int static => 3;
        _PUBLIC_FIELD: int static => 6;
        _STATIC_FIELD: int static => 16;

        unit_variant_instance_attributes() -> FieldAttributes static =>
            cast FieldAttributes(_PUBLIC_FIELD | _STATIC_FIELD);

        field_attributes(`field: Field) -> FieldAttributes static is
            let flags mut =
                if `field.is_public_readable then _PUBLIC_FIELD else _ASSEMBLY_FIELD fi;

            if isa Semantic.Symbols.STATIC_FIELD(`field) \/
               isa Semantic.Symbols.GLOBAL_VARIABLE(`field)
            then
                flags = flags | _STATIC_FIELD;
            fi

            return cast FieldAttributes(flags);
        si
    si
si
